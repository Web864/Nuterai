# NutriAI environment template. Copy to .env for local work; never commit .env.
# On Cloudflare Workers: VITE_* values are needed at BUILD time (CI or your
# machine). Server values are Worker secrets: `npx wrangler secret put NAME`.
# See docs/DEPLOY.md.

# --- Public site -----------------------------------------------------------
# Final public origin, no trailing slash. Drives canonical URLs, sitemap,
# robots.txt, llms.txt, social previews and auth redirects.
VITE_SITE_URL="https://your-domain.example"

# --- Supabase (public, safe in the browser bundle) -----------------------------
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# --- Server-side only: Worker secrets, never VITE_, never committed --------------
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI. Gemini is primary (https://aistudio.google.com/apikey); OpenAI is the
# fallback when Gemini errors. Set both in production.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
# Optional, currently unused by any code path.
LONGCAT_API_KEY=""
LONGCAT_BASE_URL="https://api.longcat.chat/openai/v1"
LONGCAT_MODEL="LongCat-2.0"

# Billing. Keep "mock" (or unset) until a real provider is wired and the owner
# approves live prices. The mock provider refuses to run in production.
# BILLING_PROVIDER="stripe"
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Android shell: the web URL the Capacitor app loads (defaults to VITE_SITE_URL).
# NUTRIAI_WEB_URL="https://your-domain.example"
